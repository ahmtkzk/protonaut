<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.protonaut</groupId>
        <artifactId>protonaut-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>protonaut-web</artifactId>
    <packaging>jar</packaging>

    <name>Protonaut :: Web Server</name>
    <description>Embedded HTTP/2 and REST server, dual-port listener, and API dispatcher for Protonaut</description>

    <dependencies>
        <dependency>
            <groupId>io.protonaut</groupId>
            <artifactId>protonaut-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.protonaut</groupId>
            <artifactId>protonaut-grpc</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.protonaut</groupId>
            <artifactId>protonaut-security</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.protonaut</groupId>
            <artifactId>protonaut-codegen</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.protonaut</groupId>
            <artifactId>protonaut-workflow</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.protonaut</groupId>
            <artifactId>protonaut-ui</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-http</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-http2</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-handler</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
