<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.protonaut</groupId>
        <artifactId>protonaut-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>protonaut-spring-boot-3-autoconfigure</artifactId>
    <packaging>jar</packaging>

    <name>Protonaut :: Spring Boot 3 Autoconfigure</name>
    <description>Spring Boot 3 auto-configuration for Protonaut gRPC Explorer and Workflow Studio</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <spring.boot.3.version>3.4.2</spring.boot.3.version>
        <spring.6.version>6.2.2</spring.6.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.protonaut</groupId>
            <artifactId>protonaut-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.protonaut</groupId>
            <artifactId>protonaut-grpc</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.protonaut</groupId>
            <artifactId>protonaut-security</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.protonaut</groupId>
            <artifactId>protonaut-codegen</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.protonaut</groupId>
            <artifactId>protonaut-workflow</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.protonaut</groupId>
            <artifactId>protonaut-ui</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.protonaut</groupId>
            <artifactId>protonaut-web</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Spring Boot 3 & Spring 6 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
            <version>${spring.boot.3.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <version>${spring.boot.3.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <version>${spring.6.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <version>${spring.boot.3.version}</version>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-inprocess</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <version>${spring.boot.3.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
